# 复制为 .env 后填写。查找顺序：$LECTURE2PDF_ENV → 当前目录及上级目录的 .env → ~/.config/lecture2pdf/.env

# ---- 文本模型（校对文字稿、整理讲义）：任意 OpenAI 兼容接口 ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
# TEXT_MODEL=deepseek-chat
# 如需与上面不同的账号：TEXT_API_KEY= / TEXT_BASE_URL=

# ---- 视觉模型（识别板书 / PPT）：必须支持图片输入 ----
# 例：阿里云百炼  VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  VISION_MODEL=qwen-vl-max
# 只填 VISION_MODEL 时复用文本模型的 Key 和地址（适用于同一平台同时提供文本和视觉模型）
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=

# ---- 可选 ----
# LECTURE_ASR=funasr                    # 语音识别：funasr（中文，默认）/ whisper（其他语言）
# LECTURE_WHISPER_MODEL=large-v3        # 仅 whisper 使用；large-v3-turbo 更快
# LECTURE2PDF_MODEL_DIR=~/.cache/lecture2pdf/models   # 本地模型目录，可指到空间更大的磁盘
# LECTURE2PDF_OUTPUT=./output            # 默认输出目录
# HF_ENDPOINT=https://hf-mirror.com      # Hugging Face 镜像（程序也会自动回退到 ModelScope）
